---
import Base from "../../layouts/Base.astro";
import Relief from "../../components/Relief.astro";
import Grade from "../../components/Grade.astro";
import SheetHeader from "../../components/SheetHeader.astro";
import SheetFooter from "../../components/SheetFooter.astro";
import { placeSummits, routesInOrder } from "../../lib/summits";
import { render } from "astro:content";
import { SITE } from "../../lib/site";

export async function getStaticPaths() {
  const routes = await routesInOrder();
  return routes.map((r, i) => ({ params: { slug: r.id }, props: { i } }));
}
const { i } = Astro.props;
const routes = await routesInOrder();
const route = routes[i]!;
const summits = placeSummits(routes);
const here = summits.find((s) => s.slug === route.id);
const { Content } = await render(route);
const prev = routes[i - 1];
const next = routes[i + 1];
const d = route.data;
const jsonld = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: d.summit,
  description: d.title,
  author: { "@type": "Person", name: SITE.name, url: SITE.url },
  url: new URL(`/routes/${route.id}`, SITE.url).href,
  keywords: d.stack.join(", "),
};
---
<Base title={d.summit} description={d.title} jsonld={jsonld}>
  <div class="stage">
    <SheetHeader overlay sheet={`Route ${d.order}`} />
    <Relief summits={summits} view={`summit:${route.id}`} class="route-relief" showRange={false} />
  </div>
  <main id="main" class="wrap">
    <article class="col route">
      <header class="head">
        <h1 style={`view-transition-name: summit-${route.id}`}>{d.summit}</h1>
        <p class="meta">
          <Grade grade={d.grade} />
          {here && <span class="num">{here.metres.toLocaleString("en")} m</span>}
          <span>{d.period}</span>
          <span>{d.kind === "work" ? "Client work" : "Personal project"}</span>
        </p>
        <p class="hook">{d.title}</p>
      </header>

      <div class="body">
        <div class="prose"><Content /></div>

        <aside class="card" aria-label="Route card">
          {d.climbs.length > 0 && (
            <section>
              <h2>What moved</h2>
              <dl class="climbs">
                {d.climbs.map((c) => (
                  <div>
                    <dt>{c.what}</dt>
                    <dd><span class="from">{c.from}</span> <span class="arrow" aria-hidden="true"></span> <strong>{c.to}</strong></dd>
                    {c.note && <dd class="note">{c.note}</dd>}
                  </div>
                ))}
              </dl>
            </section>
          )}
          {d.stack.length > 0 && (
            <section>
              <h2>Built with</h2>
              <ul role="list" class="kit">{d.stack.map((s) => <li>{s}</li>)}</ul>
            </section>
          )}
          {d.link && <p><a href={d.link}>Source on GitHub</a></p>}
        </aside>
      </div>

      <nav class="onward" aria-label="More routes">
        {prev && <a href={`/routes/${prev.id}`} class="plate back"><span>{prev.data.summit}</span></a>}
        <a href="/routes" class="plate home"><span>All routes</span></a>
        {next && <a href={`/routes/${next.id}`} class="plate"><span>{next.data.summit}</span></a>}
      </nav>
    </article>
  </main>
  <SheetFooter />
</Base>

<style>
  .stage { position: relative; height: 46svh; min-height: 300px; }
  .stage :global(.route-relief) { position: absolute; inset: 0; }
  @media (min-width: 900px) { .stage { height: 60svh; } }
  .route { padding-block: 28px 0; }
  .head { display: grid; gap: 12px; max-width: 46rem; }
  h1 { font: 600 var(--t-2xl)/1.02 var(--font-read); letter-spacing: -0.025em; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: center; font-size: var(--t-sm); color: var(--ink-3); }
  .hook { font: 400 var(--t-lg)/1.45 var(--font-read); }
  .body { display: grid; gap: 36px; margin-top: 36px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 960px) { .body { grid-template-columns: minmax(0, 1fr) 20rem; gap: 64px; align-items: start; } .card { position: sticky; top: 24px; } }
  .prose { font: 400 1.0625rem/1.72 var(--font-read); max-width: var(--measure); }
  .prose :global(p + p) { margin-top: 1.1em; }
  .card { display: grid; gap: 22px; padding: 18px 20px; border: 1px solid var(--ink); outline: 1px solid var(--ink); outline-offset: 3px; background: var(--paper); }
  .card h2 { font: 600 var(--t-xs)/1 var(--font-sign); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 12px; }
  .climbs { display: grid; gap: 14px; margin: 0; }
  .climbs dt { font-size: var(--t-sm); color: var(--ink-2); }
  .climbs dd { margin: 2px 0 0; font-variant-numeric: tabular-nums; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .climbs .from { color: var(--ink-3); }
  .climbs .arrow { width: 22px; height: 1.5px; background: var(--alpine); position: relative; }
  .climbs .arrow::after { content: ""; position: absolute; right: 0; top: -3px; width: 7px; height: 7px; border-top: 1.5px solid var(--alpine); border-right: 1.5px solid var(--alpine); rotate: 45deg; }
  .climbs .note { font-size: var(--t-xs); color: var(--ink-3); }
  .kit { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .kit li { padding: 4px 8px; border: 1px solid var(--rule); font-size: var(--t-sm); }
  .onward { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 56px; }
  .plate {
    --tip: 14px; position: relative; display: inline-flex; padding: 10px calc(var(--tip) + 10px) 10px 12px;
    background: var(--sign); color: var(--sign-ink); text-decoration: none; font-weight: 600;
    clip-path: polygon(0 0, calc(100% - var(--tip)) 0, 100% 50%, calc(100% - var(--tip)) 100%, 0 100%);
    transition: translate 240ms var(--ease-out);
  }
  .plate.back { padding: 10px 12px 10px calc(var(--tip) + 10px); clip-path: polygon(var(--tip) 0, 100% 0, 100% 100%, var(--tip) 100%, 0 50%); }
  .plate.home { clip-path: none; background: #fff; color: #141414; border: 1px solid #c9c7bd; padding-inline: 12px; }
  .plate:hover { translate: 4px 0; }
  .plate.back:hover { translate: -4px 0; }
</style>

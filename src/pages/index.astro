---
import Base from "../layouts/Base.astro";
import Relief from "../components/Relief.astro";
import Signpost from "../components/Signpost.astro";
import Grade from "../components/Grade.astro";
import SheetHeader from "../components/SheetHeader.astro";
import SheetFooter from "../components/SheetFooter.astro";
import Eggs from "../components/Eggs.astro";
import { placeSummits, routesInOrder } from "../lib/summits";
import { getCollection } from "astro:content";
import { SITE, readingMinutes, walkingTime } from "../lib/site";

const routes = await routesInOrder();
const summits = placeSummits(routes);
const at = new Map(summits.map((s) => [s.slug, s]));
const featured = routes.filter((r) => r.data.featured && at.has(r.id));
const reports = (await getCollection("reports", (r) => import.meta.env.DEV || !r.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const totalRead = reports.reduce((m, r) => m + readingMinutes(r.body ?? ""), 0);
const planned = [
  { title: "Building an ontology from scratch", grade: "T4" },
  { title: "Many agents, one output", grade: "T5" },
  { title: "To LoRA or not to LoRA", grade: "T4" },
];
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---
<Base>
  <main id="main">
    <section class="descent" aria-label="The sheet">
      <div class="stage">
        <SheetHeader overlay />
        <Relief summits={summits} class="home-relief" />
      </div>

      <div class="legs">
        <article class="leg hero" data-go="overview">
          <div class="signs">
            <Signpost
              here="Dubai"
              elevation="5 m"
              plates={[
                { label: "Work", meta: `${routes.length} summits`, href: "#routes" },
                { label: "Writing", meta: reports.length ? walkingTime(totalRead) : "weekly", href: "#reports" },
                { label: "Say hello", meta: "email", href: "#write" },
              ]}
            />
          </div>
          <div class="legend">
            <h1>Rohit Tokala</h1>
            <p class="lede">
              I'm a forward deployed engineer at a global engineering firm, building AI tools for the people who design and build
              things. Most weeks start with the same question: what are people still doing by hand that an agent could do well?
              Then I keep at it until it's fast and accurate enough that they actually use it.
            </p>
            <p class="lede small">I live in Dubai. The map is Jebel Jais, where I go hiking.</p>
            <div class="key">
              <p><svg viewBox="0 0 28 10" aria-hidden="true"><path d="M1 7c6-6 10 2 16-2s8 0 10 0" class="k-c" /></svg>Contours every 100 m</p>
              <p><svg viewBox="0 0 28 10" aria-hidden="true"><path d="M14 1.5 19 9H9Z" class="k-s" /></svg>Each summit is a project</p>
            </div>
            <div class="instruments">
              <div class="scale">
                <span class="bar" data-scale-bar></span>
                <span class="num" data-scale-label>1 km</span>
              </div>
              <p class="note" data-light-note>Light follows your pointer. Drag to lift the map.</p>
              <span class="north" data-north aria-label="North arrow" role="img">
                <svg viewBox="0 0 20 28" width="18" height="26" aria-hidden="true"><path d="M10 1 16 22 10 18 4 22Z" /><text x="10" y="27.5" text-anchor="middle">N</text></svg>
              </span>
            </div>
          </div>
        </article>

        {
          featured.map((r) => {
            const s = at.get(r.id)!;
            return (
              <article class="leg" data-go={`summit:${r.id}`} id={`leg-${r.id}`}>
                <div class="card">
                  <h2 style={`view-transition-name: summit-${r.id}`}>{r.data.summit}</h2>
                  <p class="meta">
                    <Grade grade={r.data.grade} />
                    <span class="num">{s.metres.toLocaleString("en")} m</span>
                    <span>{r.data.period}</span>
                  </p>
                  <p class="hook">{r.data.title}</p>
                  {r.data.climbs.length > 0 && (
                    <details class="climb">
                      <summary>What moved</summary>
                      <dl>
                        {r.data.climbs.map((c) => (
                          <div>
                            <dt>{c.what}</dt>
                            <dd>
                              <span class="from">{c.from}</span>
                              <svg viewBox="0 0 40 12" width="40" height="12" aria-hidden="true"><path d="M1 11 9 8l6 1 7-5 6 1 11-4" /></svg>
                              <span class="to">{c.to}</span>
                              {c.note && <small>{c.note}</small>}
                            </dd>
                          </div>
                        ))}
                      </dl>
                    </details>
                  )}
                  <a class="onward" href={`/routes/${r.id}`}>The full route</a>
                </div>
              </article>
            );
          })
        }

        <article class="leg" data-go="sheet" id="routes">
          <div class="card">
            <h2>All projects</h2>
            <p class="hook">Client work in engineering and construction, and things I build for myself.</p>
            <ol role="list" class="board">
              {
                routes.map((r) => (
                  <li>
                    <a href={`/routes/${r.id}`} data-summit-link={r.id}>
                      <span class="dest">{r.data.summit}</span>
                      <Grade grade={r.data.grade} label={false} />
                      <span class="kind">{r.data.kind === "work" ? "Work" : "Personal"}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
        </article>
      </div>
    </section>

    <section class="reports wrap" id="reports" aria-labelledby="reports-h">
      <div class="col">
        <h2 id="reports-h">Trip reports</h2>
        <p class="sub measure">Notes, about once a week, on something I built or tried and how it went. Graded like hikes, with reading times.</p>
        <ol role="list" class="log">
          {
            reports.map((r) => (
              <li>
                <time datetime={r.data.date.toISOString()}>{fmt(r.data.date)}</time>
                <a href={`/reports/${r.id}`}>{r.data.title}</a>
                <Grade grade={r.data.grade} />
                <span class="num">{walkingTime(readingMinutes(r.body ?? ""))}</span>
              </li>
            ))
          }
          {
            reports.length === 0 &&
              planned.map((p) => (
                <li class="planned">
                  <span class="when">In preparation</span>
                  <span class="t">{p.title}</span>
                  <Grade grade={p.grade} />
                  <span />
                </li>
              ))
          }
        </ol>
      </div>
    </section>

    <section class="write wrap" id="write" aria-labelledby="write-h">
      <div class="col">
        <h2 id="write-h">Say hello</h2>
        <p class="sub measure">If you're working on something hard, want to build something together, or have a science-fiction book I should read.</p>
        <p class="addr">
          <a href={`mailto:${SITE.email}`} data-email>{SITE.email}</a>
          <button type="button" class="copy" data-copy={SITE.email}>Copy</button>
        </p>
      </div>
    </section>
  </main>
  <SheetFooter />
  <Eggs />
</Base>

<script>
  type Ctl = { go(name: string): void } | null;
  const ready = (window as unknown as { __reliefReady?: Promise<Ctl> }).__reliefReady;
  const legs = [...document.querySelectorAll<HTMLElement>("[data-go]")];
  let active = "";
  const pick = () => {
    const wide = matchMedia("(min-width: 900px)").matches;
    const line = innerHeight * (wide ? 0.55 : 0.75);
    let best = legs[0];
    for (const l of legs) if (l.getBoundingClientRect().top < line) best = l;
    const name = best?.dataset.go ?? "overview";
    if (name !== active) {
      active = name;
      legs.forEach((l) => l.toggleAttribute("data-current", l === best));
      ready?.then((c) => c?.go(name));
    }
  };
  addEventListener("scroll", () => requestAnimationFrame(pick), { passive: true });
  addEventListener("resize", pick);
  pick();

  document.querySelectorAll<HTMLElement>("[data-summit-link]").forEach((a) => {
    const slug = a.dataset.summitLink!;
    const on = (v: boolean) => document.querySelector(`[data-summit="${slug}"]`)?.toggleAttribute("data-active", v);
    a.addEventListener("pointerenter", () => on(true));
    a.addEventListener("pointerleave", () => on(false));
    a.addEventListener("focus", () => on(true));
    a.addEventListener("blur", () => on(false));
  });

  const copy = document.querySelector<HTMLButtonElement>("[data-copy]");
  copy?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.copy!);
      copy.textContent = "Copied";
    } catch {
      const a = document.querySelector("[data-email]");
      if (a) getSelection()?.selectAllChildren(a);
      copy.textContent = "Selected";
    }
    setTimeout(() => (copy.textContent = "Copy"), 1800);
  });
</script>

<style>
  :root { interpolate-size: allow-keywords; }

  /* ---------- the sheet: mobile first ---------- */
  .descent { position: relative; }
  .stage { position: sticky; top: 0; z-index: 2; height: 56svh; box-shadow: 0 1px 0 var(--rule); }
  .stage :global(.home-relief) { position: absolute; inset: 0; --occlude: 0px; --poster: url(/poster/narrow-light.webp); background: var(--haze) var(--poster) center / cover no-repeat; }
  :global(:root[data-theme="dark"]) .stage :global(.home-relief) { --poster: url(/poster/narrow-dark.webp); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .stage :global(.home-relief) { --poster: url(/poster/narrow-dark.webp); } }
  @media (min-width: 900px) {
    .stage :global(.home-relief) { --poster: url(/poster/wide-light.webp); }
    :global(:root[data-theme="dark"]) .stage :global(.home-relief) { --poster: url(/poster/wide-dark.webp); }
  }
  @media (min-width: 900px) and (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .stage :global(.home-relief) { --poster: url(/poster/wide-dark.webp); } }
  .stage :global(.top) { z-index: 3; }
  .legs { position: relative; z-index: 1; }
  .leg {
    min-height: 48svh;
    padding: 22px var(--gutter-r) 44px var(--gutter);
    background: var(--paper);
    border-top: 1px solid var(--rule);
  }
  .leg.hero { min-height: auto; display: grid; gap: 26px; padding-top: 22px; }
  @media (max-width: 899px) {
    :global(html) { scroll-snap-type: y proximity; }
    .leg:not(.hero) { scroll-snap-align: start; scroll-margin-top: 56svh; }
  }
  .hero .legend { order: -1; display: grid; gap: 14px; }

  h1 { font: 600 var(--t-2xl)/1.02 var(--font-read); letter-spacing: -0.025em; max-width: 12ch; }
  .lede { font: 400 var(--t-md)/1.55 var(--font-read); color: var(--ink-2); max-width: 40ch; }
  .lede.small { font-size: var(--t-sm); color: var(--ink-3); margin-top: -4px; }
  .key { display: none; }
  .key p { display: flex; align-items: center; gap: 10px; font-size: var(--t-sm); color: var(--ink-2); }
  .key svg { width: 28px; height: 10px; flex: none; fill: none; }
  .k-c { stroke: var(--contour); stroke-width: 1.2; }
  .k-s { fill: var(--ink); }
  .instruments { display: flex; align-items: end; gap: 16px; font-size: var(--t-xs); color: var(--ink-3); }
  .scale { display: grid; gap: 4px; justify-items: start; flex: none; }
  .scale .bar {
    display: block; width: 80px; height: 5px; transition: width 200ms var(--ease-out);
    background: repeating-linear-gradient(90deg, var(--ink) 0 25%, var(--paper) 25% 50%); border: 1px solid var(--ink);
  }
  .note { flex: 1; min-width: 0; }
  .north { flex: none; transition: rotate 120ms linear; }
  .north svg { fill: var(--ink); }
  .north text { font: 600 6.5px var(--font-sign); fill: var(--ink); }

  .card { max-width: 30rem; display: grid; gap: 16px; align-content: start; }
  .card h2 { font: 600 var(--t-xl)/1.05 var(--font-read); letter-spacing: -0.02em; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font-size: var(--t-sm); color: var(--ink-3); margin-top: -6px; }
  .hook { font: 400 var(--t-lg)/1.4 var(--font-read); color: var(--ink); }

  .climb { border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .climb summary {
    cursor: pointer; list-style: none; padding: 12px 0;
    display: flex; justify-content: space-between; align-items: center;
    font: 600 var(--t-sm)/1 var(--font-sign); letter-spacing: 0.02em;
  }
  .climb summary::-webkit-details-marker { display: none; }
  .climb summary::after { content: ""; width: 8px; height: 8px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; rotate: 45deg; translate: 0 -2px; transition: rotate 240ms var(--ease-out); }
  .climb[open] summary::after { rotate: 225deg; translate: 0 2px; }
  .climb::details-content { block-size: 0; overflow: clip; transition: block-size 320ms var(--ease-out), content-visibility 320ms allow-discrete; }
  .climb[open]::details-content { block-size: auto; }
  .climb dl { display: grid; gap: 12px; padding: 2px 0 14px; margin: 0; }
  .climb dt { font-size: var(--t-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-3); }
  .climb dd { margin: 2px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font: 600 var(--t-md)/1.2 var(--font-sign); font-variant-numeric: tabular-nums; }
  .climb dd .from { color: var(--ink-3); font-weight: 400; }
  .climb dd svg { fill: none; stroke: var(--alpine); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .climb small { flex-basis: 100%; font: 400 var(--t-xs)/1.4 var(--font-sign); color: var(--ink-3); }
  .onward { justify-self: start; font-weight: 600; }

  .board { margin: 4px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .board a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 12px; align-items: center;
    padding: 11px 2px; border-bottom: 1px solid var(--rule); text-decoration: none;
    transition: background-color 160ms var(--ease-out), padding 240ms var(--ease-out);
  }
  .board a:hover, .board a:focus-visible { background: color-mix(in oklab, var(--sign) 22%, transparent); padding-inline: 8px; }
  .board .dest { font-weight: 600; }
  .board .kind { font-size: var(--t-xs); color: var(--ink-3); min-width: 5.5em; text-align: right; }

  /* ---------- desktop: the map is the page; the text sits on it like a legend ---------- */
  @media (min-width: 900px) {
    .stage { height: 100svh; z-index: 0; box-shadow: none; }
    .stage :global(.home-relief) { --occlude: 500px; }
    .legs { margin-top: -100svh; pointer-events: none; }
    .leg { min-height: 100svh; display: flex; align-items: center; padding: 96px 0 64px calc(var(--gutter) + 28px); background: none; border: 0; }
    .leg.hero { display: block; position: relative; height: 100svh; padding: 0; }
    .hero .signs { position: absolute; left: calc(var(--gutter) + 28px); top: 50%; translate: 0 -55%; pointer-events: auto; }
    .hero .legend {
      position: absolute; right: calc(var(--gutter-r) + 24px); bottom: 28px; width: 27rem; pointer-events: auto;
      padding: 24px 26px 18px;
    }
    .key { display: grid; gap: 6px; padding-top: 12px; border-top: 1px solid var(--rule); }
    .instruments { padding-top: 12px; border-top: 1px solid var(--rule); }
    .card { pointer-events: auto; width: 27rem; padding: 22px 24px 24px; }
    .hero .legend, .card {
      background: color-mix(in oklab, var(--paper) 95%, transparent);
      border: 1px solid var(--ink);
      outline: 1px solid var(--ink); outline-offset: 3px;
      box-shadow: var(--shadow);
    }
    h1 { font-size: clamp(2.4rem, 1.4rem + 2.2vw, 3.4rem); max-width: 13ch; }
  }

  /* ---------- below the sheet ---------- */
  .reports, .write { padding-block: 72px 8px; }
  .reports h2, .write h2 { font: 600 var(--t-xl)/1.05 var(--font-read); letter-spacing: -0.02em; }
  .sub { margin-top: 10px; color: var(--ink-2); font: 400 var(--t-md)/1.55 var(--font-read); }
  .log { margin: 28px 0 0; padding: 0; list-style: none; border-top: 2px solid var(--ink); }
  .log li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--rule); }
  .log time, .log .when { grid-column: 1 / -1; font-size: var(--t-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .log a, .log .t { font: 500 var(--t-lg)/1.3 var(--font-read); }
  .planned .t { color: var(--ink-2); }
  @media (min-width: 720px) {
    .log li { grid-template-columns: 10rem minmax(0, 1fr) auto 5rem; }
    .log time, .log .when { grid-column: auto; }
  }
  .addr { margin-top: 22px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 18px; }
  .addr a { font: 500 clamp(1.5rem, 1rem + 3vw, 2.6rem)/1.1 var(--font-read); letter-spacing: -0.015em; overflow-wrap: anywhere; }
  .copy { padding: 8px 14px; border: 1px solid var(--rule); border-radius: 999px; background: var(--paper); cursor: pointer; font: 600 var(--t-sm)/1 var(--font-sign); color: var(--ink); }
  .copy:hover { border-color: var(--ink-3); }
</style>

---
/**
 * An interactive line chart: drag the slider (or the chart) to read every series at one x.
 * <Scrubber x="Examples in context" y="Task accuracy" unit="%" series={[{ name: "Prompted", points: [[0, 41], ...] }]} />
 */
interface Series { name: string; points: [number, number][] }
interface Props { x: string; y: string; unit?: string; xunit?: string; series: Series[]; caption?: string; illustrative?: boolean }
const { x, y, unit = "", xunit = "", series, caption, illustrative = false } = Astro.props;
const xs = series.flatMap((s) => s.points.map((p) => p[0]));
const ys = series.flatMap((s) => s.points.map((p) => p[1]));
const [x0, x1] = [Math.min(...xs), Math.max(...xs)];
const pad = (Math.max(...ys) - Math.min(...ys)) * 0.08 || 1;
const [y0, y1] = [Math.min(...ys) - pad, Math.max(...ys) + pad];
const W = 640, H = 300, L = 44, R = 16, T = 16, B = 34;
const sx = (v: number) => L + ((v - x0) / (x1 - x0 || 1)) * (W - L - R);
const sy = (v: number) => H - B - ((v - y0) / (y1 - y0 || 1)) * (H - T - B);
const ticks = Array.from({ length: 5 }, (_, i) => y0 + ((y1 - y0) * i) / 4);
const xticks = Array.from({ length: 5 }, (_, i) => x0 + ((x1 - x0) * i) / 4);
const fmt = (v: number) => (Math.abs(v) >= 100 ? Math.round(v).toString() : v.toFixed(Math.abs(v) < 10 ? 1 : 0));
const uid = `s${Math.random().toString(36).slice(2, 8)}`;
---
<figure class="scrubber" data-scrubber data-series={JSON.stringify(series)} data-x0={x0} data-x1={x1} data-unit={unit} data-xunit={xunit}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${uid}-t`}>
    <title id={`${uid}-t`}>{y} against {x}</title>
    {ticks.map((t) => <g class="tick"><line x1={L} x2={W - R} y1={sy(t)} y2={sy(t)} /><text x={L - 8} y={sy(t) + 4} text-anchor="end">{fmt(t)}</text></g>)}
    {xticks.map((t) => <text class="xt" x={sx(t)} y={H - B + 18} text-anchor="middle">{fmt(t)}</text>)}
    {series.map((s, i) => <path class={`line c${i}`} d={s.points.map((p, j) => `${j ? "L" : "M"}${sx(p[0]).toFixed(1)} ${sy(p[1]).toFixed(1)}`).join(" ")} />)}
    <line class="cross" data-cross x1={L} x2={L} y1={T} y2={H - B} />
    {series.map((_, i) => <circle class={`dot c${i}`} data-dot r="4.5" cx={L} cy={H - B} />)}
  </svg>
  <div class="controls">
    <label>
      <span>{x}</span>
      <input type="range" min={x0} max={x1} step={(x1 - x0) / 200} value={x0 + (x1 - x0) * 0.35} data-range aria-label={x} />
    </label>
    <output data-out aria-live="polite"></output>
  </div>
  <figcaption>
    <span class="axis">{y}{unit && ` (${unit})`}</span>
    {series.map((s, i) => <span class={`key c${i}`}>{s.name}</span>)}
    {caption && <span class="cap">{caption}</span>}
    {illustrative && <span class="cap">Illustrative data.</span>}
  </figcaption>
</figure>

<script>
  type S = { name: string; points: [number, number][] };
  class Scrub {
    constructor(root: HTMLElement) {
      const series: S[] = JSON.parse(root.dataset.series!);
      const x0 = +root.dataset.x0!, x1 = +root.dataset.x1!;
      const unit = root.dataset.unit ?? "", xunit = root.dataset.xunit ?? "";
      const svg = root.querySelector("svg")!;
      const range = root.querySelector<HTMLInputElement>("[data-range]")!;
      const out = root.querySelector<HTMLOutputElement>("[data-out]")!;
      const cross = root.querySelector<SVGLineElement>("[data-cross]")!;
      const dots = [...root.querySelectorAll<SVGCircleElement>("[data-dot]")];
      const paths = [...root.querySelectorAll<SVGPathElement>("path.line")];
      const at = (s: S, x: number) => {
        const p = s.points;
        for (let i = 1; i < p.length; i++) if (x <= p[i]![0]) { const [a, b] = [p[i - 1]!, p[i]!]; const k = (x - a[0]) / (b[0] - a[0] || 1); return a[1] + (b[1] - a[1]) * k; }
        return p[p.length - 1]![1];
      };
      const vb = svg.viewBox.baseVal;
      const update = () => {
        const x = +range.value;
        // position the cross by sampling the first path at the right fraction of its length
        const ref = paths[0]!;
        const fx = (x - x0) / (x1 - x0 || 1);
        const px = 44 + fx * (vb.width - 44 - 16);
        cross.setAttribute("x1", String(px)); cross.setAttribute("x2", String(px));
        series.forEach((s, i) => {
          const v = at(s, x);
          // find y on the drawn path by bisection on x
          const path = paths[i]!; let lo = 0, hi = path.getTotalLength();
          for (let k = 0; k < 18; k++) { const m = (lo + hi) / 2; if (path.getPointAtLength(m).x < px) lo = m; else hi = m; }
          const pt = path.getPointAtLength(lo);
          dots[i]!.setAttribute("cx", String(pt.x)); dots[i]!.setAttribute("cy", String(pt.y));
          dots[i]!.dataset.v = v.toFixed(1);
        });
        void ref;
        out.textContent = `${(+x.toFixed(1)).toLocaleString("en")}${xunit}: ` + series.map((s) => `${s.name} ${at(s, x).toFixed(1)}${unit}`).join(" · ");
      };
      range.addEventListener("input", update);
      const drag = (e: PointerEvent) => {
        const r = svg.getBoundingClientRect();
        const fx = ((e.clientX - r.left) / r.width * vb.width - 44) / (vb.width - 60);
        range.value = String(x0 + Math.min(1, Math.max(0, fx)) * (x1 - x0));
        update();
      };
      svg.addEventListener("pointerdown", (e) => { svg.setPointerCapture(e.pointerId); drag(e); svg.addEventListener("pointermove", drag); });
      svg.addEventListener("pointerup", () => svg.removeEventListener("pointermove", drag));
      update();
    }
  }
  document.querySelectorAll<HTMLElement>("[data-scrubber]").forEach((el) => new Scrub(el));
</script>

<style>
  .scrubber { margin: 2em 0; padding: 16px 16px 12px; border: 1px solid var(--rule); background: var(--paper); display: grid; gap: 10px; }
  svg { width: 100%; height: auto; touch-action: pan-y; cursor: ew-resize; overflow: visible; }
  .tick line { stroke: var(--rule); stroke-width: 1; }
  text { font: 500 11px var(--font-sign); fill: var(--ink-3); font-variant-numeric: tabular-nums; }
  .line { fill: none; stroke-width: 2.2; stroke-linejoin: round; stroke-linecap: round; }
  .c0 { stroke: var(--contour); color: var(--contour); }
  .c1 { stroke: var(--lake); color: var(--lake); }
  .c2 { stroke: var(--alpine); color: var(--alpine); }
  .dot { fill: var(--paper); stroke-width: 2.2; transition: cx 60ms linear, cy 60ms linear; }
  .cross { stroke: var(--ink); stroke-dasharray: 3 3; stroke-width: 1; }
  .controls { display: grid; gap: 8px; }
  label { display: grid; gap: 6px; font: 600 var(--t-xs)/1 var(--font-sign); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); }
  input[type="range"] { width: 100%; accent-color: var(--contour); }
  output { font: 500 var(--t-sm)/1.4 var(--font-sign); font-variant-numeric: tabular-nums; color: var(--ink); min-height: 1.4em; }
  figcaption { display: flex; flex-wrap: wrap; gap: 6px 16px; font: 400 var(--t-xs)/1.4 var(--font-sign); color: var(--ink-3); }
  .key::before { content: ""; display: inline-block; width: 14px; height: 2.5px; background: currentColor; margin-right: 6px; translate: 0 -3px; }
  .axis { color: var(--ink-2); }
</style>

---
/** Small things for people who poke around. None of them are announced. */
---
<div class="toast" role="status" aria-live="polite" data-toast hidden>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" data-toast-arrow><path d="M4 12h15M13 6l6 6-6 6" /></svg>
  <span data-toast-text></span>
</div>
<script>
  // Hyderabad from the Jebel Jais summit: great-circle distance and initial bearing.
  const from = { lat: 25.955, lon: 56.18 },
    to = { lat: 17.385, lon: 78.4867 };
  const r = Math.PI / 180;
  const dLat = (to.lat - from.lat) * r,
    dLon = (to.lon - from.lon) * r;
  const a = Math.sin(dLat / 2) ** 2 + Math.cos(from.lat * r) * Math.cos(to.lat * r) * Math.sin(dLon / 2) ** 2;
  const km = Math.round((6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a))) / 10) * 10;
  const y = Math.sin(dLon) * Math.cos(to.lat * r);
  const x = Math.cos(from.lat * r) * Math.sin(to.lat * r) - Math.sin(from.lat * r) * Math.cos(to.lat * r) * Math.cos(dLon);
  const bearing = (Math.atan2(y, x) / r + 360) % 360;

  const toast = document.querySelector<HTMLElement>("[data-toast]");
  const text = document.querySelector<HTMLElement>("[data-toast-text]");
  const arrow = document.querySelector<SVGElement>("[data-toast-arrow]");
  let t = 0;
  function show(msg: string, deg?: number) {
    if (!toast || !text || !arrow) return;
    text.textContent = msg;
    arrow.style.rotate = deg === undefined ? "0deg" : `${deg - 90}deg`;
    toast.hidden = false;
    requestAnimationFrame(() => toast.setAttribute("data-on", ""));
    clearTimeout(t);
    t = window.setTimeout(() => {
      toast.removeAttribute("data-on");
      setTimeout(() => (toast.hidden = true), 400);
    }, 5200);
  }
  document.addEventListener("egg:biryani", () => show(`Hyderabad, ${km.toLocaleString("en")} km that way. Worth the trip for the biryani.`, bearing));

  console.log(
    "%c\n   /\\      /\\  /\\\n  /  \\/\\  /  \\/  \\\n /      \\/        \\\n\n%cYou found the survey office. The mountain is real: Jebel Jais, drawn from open elevation data in a few hundred lines of WebGL.\nThere are a couple of other things hidden on this sheet. Try a classic code, or type what Hyderabad is famous for.",
    "color:#a8662f;font:12px/1.2 monospace",
    "font:13px/1.5 system-ui",
  );
</script>
<style>
  .toast {
    position: fixed; z-index: 50;
    left: 50%; bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    display: flex; align-items: center; gap: 10px;
    max-width: min(92vw, 30rem);
    padding: 12px 16px;
    background: var(--sign); color: var(--sign-ink);
    font: 600 var(--t-sm)/1.35 var(--font-sign);
    border-radius: 2px;
    box-shadow: var(--shadow);
    translate: -50% 140%;
    transition: translate 420ms var(--ease-out);
  }
  .toast[data-on] { translate: -50% 0; }
  .toast svg { flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: rotate 600ms var(--ease-out); }
</style>
